<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Phone Warrior scans your phone LOCALLY.
      There is NO internet permission on purpose: this app cannot send
      any data anywhere. What it sees stays on your phone.
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".PhoneWarriorApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.PhoneWarrior"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait" />

        <!-- Launch icons are aliases so Disguise Mode can swap which one shows -->
        <activity-alias
            android:name=".LauncherWarrior"
            android:targetActivity=".MainActivity"
            android:label="Phone Warrior"
            android:icon="@mipmap/ic_launcher"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Guard mode: loud-audio trigger recorder (30s pre-buffer) -->
        <service
            android:name=".GuardService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Disguise Mode: swaps the home-screen icon to a boring gray Notes app -->
        <activity-alias
            android:name=".LauncherNotes"
            android:targetActivity=".MainActivity"
            android:label="Notes"
            android:icon="@mipmap/ic_notes"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
